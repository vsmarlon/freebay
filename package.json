{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "scripts": {
    "prepare": "husky",
    "ci:check": "node scripts/ci-check.js",
    "test:ci-scripts": "node --test scripts/ci-check.test.js scripts/perf-check.test.js"
  },
  "lint-staged": {
    "nest-backend/src/**/*.ts": [
      "npx --no-install eslint --config nest-backend/eslint.config.js --fix"
    ],
    "frontend/lib/**/*.dart": [
      "dart format"
    ]
  }
}
