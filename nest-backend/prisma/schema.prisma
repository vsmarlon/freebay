// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum Condition {
  NEW
  USED
}

enum ProductStatus {
  ACTIVE
  SOLD
  PAUSED
  DELETED
}

enum PostType {
  PRODUCT
  REGULAR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  DISPUTED
  COMPLETED
  CANCELLED
}

enum WalletBalanceKind {
  AVAILABLE
  PENDING
  TOTAL_EARNED
}

enum WalletEntryReason {
  SALE_HELD
  SALE_RELEASED
  HOLD_RELEASED
  REFUND
  DISPUTE_REFUND
  DISPUTE_RELEASE
  PAYOUT
  WITHDRAWAL
  ADJUSTMENT
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentProvider {
  STRIPE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  PAID
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum TransferDeliveryState {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYABLE
  TERMINAL
}

enum ReversalState {
  NOT_REQUIRED
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYABLE
  TERMINAL
}

enum DisputeStatus {
  OPEN
  AWAITING_SELLER
  AWAITING_BUYER
  RESOLVED
  CANCELLED
}

enum ReviewType {
  BUYER_REVIEWING_SELLER
  SELLER_REVIEWING_BUYER
}

enum ConversationStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum ChatThreadType {
  ORDER
  DIRECT
}

enum ChatTheme {
  DEFAULT
  CRIMSON
  COBALT
  FOREST
  AMBER
  SLATE
}

enum ReportTargetType {
  USER
  POST
  CONVERSATION
  MESSAGE
  ORDER_CHAT
  CHAT_MESSAGE
}

// ─── Models ────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  displayName     String
  username        String?   @unique
  email           String    @unique
  emailVerified   Boolean   @default(false)
  passwordHash    String?
  googleId        String?   @unique
  cpfHash         String?   @unique
  cpf             String?
  phone           String?
  phoneVerified   Boolean   @default(false)
  city            String?
  state           String?
  avatarUrl       String?
  bannerUrl       String?
  bio             String?   @db.VarChar(150)
  isVerified      Boolean   @default(false)
  isGuest         Boolean   @default(false)
  role            UserRole  @default(USER)
  reputationScore Float     @default(0)
  totalReviews    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  lastSeenAt      DateTime?

  deletionRequestedAt DateTime?
  suspendedAt         DateTime?
  suspensionReason    String?

  wallet                  Wallet?
  connectAccount          ConnectAccount?
  walletEntries           WalletEntry[]
  products                Product[]
  posts                   Post[]
  savedPosts              SavedPost[]
  ordersAsBuyer           Order[]                  @relation("BuyerOrders")
  ordersAsSeller          Order[]                  @relation("SellerOrders")
  reviewsGiven            Review[]                 @relation("ReviewsGiven")
  reviewsReceived         Review[]                 @relation("ReviewsReceived")
  followers               Follow[]                 @relation("Following")
  following               Follow[]                 @relation("Followers")
  blocksGiven             Block[]                  @relation("Blocker")
  blocksReceived          Block[]                  @relation("Blocked")
  disputes                Dispute[]
  comments                Comment[]
  likes                   Like[]
  shares                  Share[]
  chatMessages            ChatMessage[]
  stories                 Story[]
  storyHighlights         StoryHighlight[]
  commentLikes            CommentLike[]
  favorites               Favorite[]
  cartItems               CartItem[]
  passwordRecoveryCodes   PasswordRecoveryCode[]
  phoneVerificationCodes  PhoneVerificationCode[]
  convosAsUser1           DirectConversation[]     @relation("User1Convos")
  convosAsUser2           DirectConversation[]     @relation("User2Convos")
  directMessages          DirectMessage[]
  conversationPreferences ConversationPreference[]
  messageReactions        MessageReaction[]
  starredMessages         StarredMessage[]
  notifications           Notification[]
  postMentions            PostMention[]            @relation("PostMentions")
  commentMentions         CommentMention[]         @relation("CommentMentions")
  submittedReports        Report[]                 @relation("SubmittedReports")
  reportedUserReports     Report[]                 @relation("ReportedUserReports")
  bugReports              BugReport[]
  moderationActions       ModerationAction[]       @relation("ModerationActor")
  reviewedReports         Report[]                 @relation("ReviewedReports")
  resolvedDisputes        Dispute[]                @relation("ResolvedDisputes")
  fcmToken                String?
  notificationPrefs       Json?                    @default("{\"orders\":true,\"follows\":true,\"messages\":true,\"disputes\":true}")
  webConsentGrantedAt     DateTime?
  webConsentIp            String?
  webConsentUserAgent     String?

  @@index([email])
  @@index([createdAt])
  @@index([deletionRequestedAt])
}

model PasswordRecoveryCode {
  id              String    @id @default(uuid())
  userId          String
  codeHash        String
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  requestedAt     DateTime  @default(now())
  sentAt          DateTime?
  expiresAt       DateTime
  usedAt          DateTime?
  requestedIp     String?
  userAgent       String?
  resendMessageId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, usedAt, expiresAt])
  @@index([codeHash])
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

model WebMagicLink {
  id              String    @id @default(uuid())
  email           String
  tokenHash       String    @unique
  consentGranted  Boolean
  consentAt       DateTime?
  requestedAt     DateTime  @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  activatedAt     DateTime?
  sendAcceptedAt  DateTime?
  resendMessageId String?
  requestedIp     String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email, requestedAt])
  @@index([email, consumedAt, expiresAt])
  @@index([expiresAt])
}

model PhoneVerificationCode {
  id                String    @id @default(uuid())
  userId            String
  phone             String
  codeHash          String
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  requestedAt       DateTime  @default(now())
  sentAt            DateTime?
  expiresAt         DateTime
  usedAt            DateTime?
  provider          String?
  providerMessageId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, usedAt, expiresAt])
  @@index([codeHash])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Int // em centavos — nunca float
  condition   Condition
  categoryId  String?
  status      ProductStatus @default(ACTIVE)
  quantity    Int           @default(1)
  soldCount   Int           @default(0)
  sellerId    String
  postId      String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  seller    User           @relation(fields: [sellerId], references: [id])
  post      Post?          @relation(fields: [postId], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  orders    Order[]
  favorites Favorite[]
  cartItems CartItem[]
  directConversations DirectConversation[]

  @@index([sellerId, createdAt])
  @@index([status])
  @@index([categoryId])
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model ProductImage {
  id        String @id @default(uuid())
  url       String
  order     Int    @default(0)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Post {
  id            String    @id @default(uuid())
  content       String?
  imageUrl      String?
  type          PostType
  userId        String
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  sharesCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user                User          @relation(fields: [userId], references: [id])
  product             Product?
  comments            Comment[]
  likes               Like[]
  shares              Share[]
  savedBy             SavedPost[]
  mentions            PostMention[]
  reportedPostReports Report[]      @relation("ReportedPostReports")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([deletedAt])
}

model PostMention {
  id              String   @id @default(uuid())
  postId          String
  mentionedUserId String
  createdAt       DateTime @default(now())

  post          Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentionedUser User @relation("PostMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedUserId])
  @@index([postId])
  @@index([mentionedUserId])
}

model Comment {
  id         String    @id @default(uuid())
  content    String
  userId     String
  postId     String
  parentId   String?
  likesCount Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent       Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Comment[]        @relation("CommentReplies")
  commentLikes CommentLike[]
  mentions     CommentMention[]

  @@index([userId])
  @@index([postId])
  @@index([parentId])
  @@index([deletedAt])
}

model CommentMention {
  id              String   @id @default(uuid())
  commentId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation("CommentMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([commentId])
  @@index([mentionedUserId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

model Share {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Followers", fields: [followerId], references: [id])
  following User @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Order {
  id                  String       @id @default(uuid())
  buyerId             String
  sellerId            String
  productId           String
  quantity            Int          @default(1)
  amount              Int
  platformFee         Int
  sellerAmount        Int
  status              OrderStatus  @default(PENDING)
  escrowStatus        EscrowStatus @default(HELD)
  meetingScheduledAt  DateTime?
  deliveryConfirmedAt DateTime?
  cancellationReason  String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  buyer                   User                     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller                  User                     @relation("SellerOrders", fields: [sellerId], references: [id])
  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  transaction             Transaction?
  walletEntries           WalletEntry[]
  dispute                 Dispute?
  reviews                 Review[]
  chatMessages            ChatMessage[]
  conversationPreferences ConversationPreference[]
  reportedOrderReports    Report[]                 @relation("ReportedOrderReports")

  @@index([buyerId])
  @@index([sellerId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@index([productId, status])
}

model Transaction {
  id                String            @id @default(uuid())
  orderId           String            @unique
  externalId        String?
  amount            Int
  platformFee       Int
  sellerAmount      Int
  paymentMethod     PaymentMethod
  provider          PaymentProvider
  status            TransactionStatus @default(PENDING)
  idempotencyKey    String            @unique
  checkoutUrl       String?
  checkoutExpiresAt DateTime?
  chargeId          String?
  transferId        String?
  paidAt            DateTime?
  releasedAt        DateTime?
  paymentGroupId    String?
  transferState     TransferDeliveryState @default(PENDING)
  transferAttempts  Int                   @default(0)
  transferProcessingAt DateTime?
  transferIdempotencyKey String            @unique @default(uuid())
  transferLastError String?
  reversalState     ReversalState         @default(NOT_REQUIRED)
  reversalAttempts  Int                   @default(0)
  reversalProcessingAt DateTime?
  reversalIdempotencyKey String            @unique @default(uuid())
  reversalId        String?
  reversalLastError String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order        Order         @relation(fields: [orderId], references: [id])
  paymentGroup PaymentGroup? @relation(fields: [paymentGroupId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([idempotencyKey])
  @@index([paymentGroupId])
  @@index([status, checkoutExpiresAt])
  @@index([transferState, transferProcessingAt])
  @@index([reversalState, reversalProcessingAt])
}

enum PaymentGroupStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model PaymentGroup {
  id                    String             @id @default(uuid())
  buyerId               String
  amount                Int
  currency              String             @default("brl")
  status                PaymentGroupStatus @default(PENDING)
  provider              PaymentProvider
  idempotencyKey        String             @unique
  stripePaymentIntentId String?            @unique
  stripeSessionId       String?            @unique
  clientSecret          String?
  checkoutUrl           String?
  chargeId              String?
  expiresAt             DateTime?
  paidAt                DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  transactions Transaction[]

  @@index([buyerId, createdAt])
  @@index([status, expiresAt])
}

model ConnectAccount {
  id               String   @id @default(uuid())
  userId           String   @unique
  stripeAccountId  String   @unique
  country          String
  defaultCurrency  String
  transfersEnabled Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
  requirementsDue  String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model WalletEntry {
  id         String            @id @default(uuid())
  userId     String
  kind       WalletBalanceKind
  amount     Int
  reason     WalletEntryReason
  orderId    String?
  transferId String?
  createdAt  DateTime          @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@index([orderId])
}

model Wallet {
  id               String  @id @default(uuid())
  userId           String  @unique
  availableBalance Int     @default(0)
  pendingBalance   Int     @default(0)
  totalEarned      Int     @default(0)
  recipientId      String?

  user        User         @relation(fields: [userId], references: [id])
}

model Dispute {
  id             String        @id @default(uuid())
  orderId        String        @unique
  openedById     String
  status         DisputeStatus @default(OPEN)
  reason         String
  buyerEvidence  Json?
  sellerEvidence Json?
  resolution     String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime      @default(now())
  expiresAt      DateTime

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy   User  @relation(fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ResolvedDisputes", fields: [resolvedById], references: [id], onDelete: SetNull)
}

model Review {
  id         String     @id @default(uuid())
  reviewerId String
  reviewedId String
  orderId    String
  type       ReviewType
  score      Int // 1–5
  comment    String?
  createdAt  DateTime   @default(now())

  images   ReviewImage[]
  reviewer User          @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewed User          @relation("ReviewsReceived", fields: [reviewedId], references: [id])
  order    Order         @relation(fields: [orderId], references: [id])

  @@unique([reviewerId, orderId, type])
  @@index([reviewedId])
  @@index([reviewedId, createdAt])
}

model ReviewImage {
  id       String @id @default(uuid())
  url      String
  order    Int    @default(0)
  reviewId String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ChatMessage {
  id              String      @id @default(uuid())
  orderId         String
  senderId        String
  clientMessageId String?
  content         String?
  type            MessageType @default(TEXT)
  attachmentUrl   String?
  metadata        Json?
  deliveredAt     DateTime?
  readAt          DateTime?
  replyToId       String?
  viewOnce        Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())

  order                  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender                 User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo                ChatMessage?      @relation("CmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies                ChatMessage[]       @relation("CmReplies")
  reactions              MessageReaction[]
  starredBy              StarredMessage[]
  reportedChatMsgReports Report[]          @relation("ReportedChatMsgReports")

  @@unique([orderId, senderId, clientMessageId])
  @@index([orderId, createdAt])
  @@index([attachmentUrl])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Story {
  id        String    @id @default(uuid())
  userId    String
  imageUrl  String
  mediaType StoryMediaType @default(IMAGE)
  caption   String?
  textBlocks Json?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user  User        @relation(fields: [userId], references: [id])
  views StoryView[]
  highlightItems StoryHighlightItem[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([deletedAt])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  GIF
  LOCATION
  PRODUCT_CARD
}

model StoryHighlight {
  id           String   @id @default(uuid())
  userId       String
  title        String   @db.VarChar(40)
  coverStoryId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories StoryHighlightItem[]

  @@index([userId, createdAt])
}

model StoryHighlightItem {
  highlightId String
  storyId     String
  position    Int

  highlight StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([highlightId, storyId])
  @@unique([highlightId, position])
  @@index([storyId])
}

model MessageReaction {
  id              String   @id @default(uuid())
  emoji           String
  userId          String
  directMessageId String?
  chatMessageId   String?
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  directMessage DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  chatMessage   ChatMessage?   @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, directMessageId])
  @@unique([userId, chatMessageId])
  @@index([directMessageId])
  @@index([chatMessageId])
}

model StarredMessage {
  id              String   @id @default(uuid())
  userId          String
  directMessageId String?
  chatMessageId   String?
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  directMessage DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  chatMessage   ChatMessage?   @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, directMessageId])
  @@unique([userId, chatMessageId])
  @@index([userId])
  @@index([directMessageId])
  @@index([chatMessageId])
}

model DirectConversation {
  id            String             @id @default(uuid())
  user1Id       String
  user2Id       String
  productId     String?
  scopeKey      String             @default("DIRECT")
  status        ConversationStatus @default(PENDING)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())

  user1                     User                     @relation("User1Convos", fields: [user1Id], references: [id], onDelete: Cascade)
  user2                     User                     @relation("User2Convos", fields: [user2Id], references: [id], onDelete: Cascade)
  product                   Product?                @relation(fields: [productId], references: [id], onDelete: Restrict)
  messages                  DirectMessage[]
  preferences               ConversationPreference[]
  reportedDirectConvReports Report[]                 @relation("ReportedDirectConvReports")

  @@unique([user1Id, user2Id, scopeKey])
  @@index([productId])
  @@index([user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
}

model DirectMessage {
  id              String      @id @default(uuid())
  conversationId  String
  senderId        String
  clientMessageId String?
  content         String?
  type            MessageType @default(TEXT)
  attachmentUrl   String?
  metadata        Json?
  deliveredAt     DateTime?
  readAt          DateTime?
  replyToId       String?
  viewOnce        Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())

  conversation             DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                   User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo                  DirectMessage?     @relation("DmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies                DirectMessage[]     @relation("DmReplies")
  reactions              MessageReaction[]
  starredBy              StarredMessage[]
  reportedDirectMsgReports Report[]           @relation("ReportedDirectMsgReports")

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([attachmentUrl])
}

// ─── Per-user conversation preferences (archive, theme, background) ────

model ConversationPreference {
  id                   String    @id @default(uuid())
  userId               String
  orderId              String?
  directConversationId String?
  isArchived           Boolean   @default(false)
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  theme                ChatTheme @default(DEFAULT)
  backgroundUrl        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  directConversation DirectConversation? @relation(fields: [directConversationId], references: [id], onDelete: Cascade)

  @@unique([userId, orderId])
  @@unique([userId, directConversationId])
}

enum ReportReason {
  FALSE_ADVERTISING
  SPAM
  FRAUD
  NUDITY
  HARASSMENT
  OTHER
  FAKE_ACCOUNT
  IMPERSONATING
  BLACKMAIL
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

model Report {
  id                           String           @id @default(uuid())
  reporterId                   String
  reportedUserId               String?
  reportedPostId               String?
  targetType                   ReportTargetType @default(USER)
  reportedDirectConversationId String?
  reportedOrderChatId          String?
  reportedDirectMessageId      String?
  reportedChatMessageId        String?
  reason                       ReportReason
  description                  String?
  hideFromUser                 Boolean          @default(false)
  status                       ReportStatus     @default(PENDING)
  createdAt                    DateTime         @default(now())
  reviewedAt                   DateTime?
  reviewedById                 String?

  reviewedBy         User?               @relation("ReviewedReports", fields: [reviewedById], references: [id], onDelete: SetNull)
  moderationActions  ModerationAction[]
  reporter           User                @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser       User?               @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedPost       Post?               @relation("ReportedPostReports", fields: [reportedPostId], references: [id], onDelete: Cascade)
  reportedDirectConv DirectConversation? @relation("ReportedDirectConvReports", fields: [reportedDirectConversationId], references: [id], onDelete: Cascade)
  reportedOrder      Order?              @relation("ReportedOrderReports", fields: [reportedOrderChatId], references: [id], onDelete: Cascade)
  reportedDirectMsg  DirectMessage?      @relation("ReportedDirectMsgReports", fields: [reportedDirectMessageId], references: [id], onDelete: Cascade)
  reportedChatMsg    ChatMessage?        @relation("ReportedChatMsgReports", fields: [reportedChatMessageId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedUserId])
  @@unique([reporterId, reportedPostId])
  @@unique([reporterId, reportedDirectConversationId])
  @@unique([reporterId, reportedOrderChatId])
  @@unique([reporterId, reportedDirectMessageId])
  @@unique([reporterId, reportedChatMessageId])
  @@index([reporterId])
  @@index([status])
  @@index([reportedUserId])
  @@index([reportedPostId])
  @@index([reportedDirectConversationId])
  @@index([status, createdAt])
}

enum ModerationTargetType {
  USER
  PRODUCT
  POST
  COMMENT
  REPORT
}

enum ModerationActionType {
  REPORT_REVIEWED
  REPORT_RESOLVED
  REPORT_REJECTED
  USER_SUSPENDED
  USER_UNSUSPENDED
  PRODUCT_REMOVED
  POST_REMOVED
  COMMENT_REMOVED
}

model ModerationAction {
  id         String               @id @default(uuid())
  actorId    String
  targetType ModerationTargetType
  targetId   String
  action     ModerationActionType
  reason     String?
  reportId   String?
  createdAt  DateTime             @default(now())

  actor  User    @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model BugReport {
  id            String   @id @default(uuid())
  userId        String?
  description   String
  appVersion    String?
  platform      String?
  screenContext String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

enum NotificationType {
  ORDER
  FOLLOW
  MESSAGE
  DISPUTE
  PAYMENT
  MENTION
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}
