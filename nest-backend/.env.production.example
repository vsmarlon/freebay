# ==========================================
# FREEBAY BACKEND - PRODUCTION ENVIRONMENT
# ==========================================
NODE_ENV=production
PORT=3000

# Database & Cache (Production PostgreSQL & Redis)
DATABASE_URL="postgresql://freebay_prod_user:SECURE_STRONG_PASSWORD@postgres-host:5432/freebay_prod?schema=public&sslmode=require"
REDIS_URL="rediss://default:REDIS_STRONG_PASSWORD@redis-host:6379"

# Security & Tokens
JWT_SECRET="GENERATE_A_VERY_LONG_RANDOM_64_CHAR_HEX_KEY_FOR_PRODUCTION"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Providers (Stripe Live Mode)
STRIPE_SECRET_KEY="rk_live_YOUR_LIVE_RESTRICTED_KEY"
STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_LIVE_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_LIVE_WEBHOOK_SIGNING_SECRET"

# Email Delivery (Resend with Custom Domain)
RESEND_API_KEY="re_YOUR_PRODUCTION_RESEND_API_KEY"
RESEND_FROM_EMAIL="FreeBay <suporte@freebay.app>"
EMAIL_FROM="FreeBay <no-reply@freebay.app>"

# Cloud Storage (AWS S3 or Cloudflare R2)
STORAGE_DRIVER=s3
AWS_REGION=auto
AWS_S3_BUCKET=freebay-production-uploads
AWS_ACCESS_KEY_ID=YOUR_R2_OR_S3_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_R2_OR_S3_SECRET
AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://cdn.freebay.app

# Application URLs & Deep-linking
APP_URL=https://app.freebay.app
API_URL=https://api.freebay.app
DEEP_LINK_SCHEME=freebay

GOOGLE_CLIENT_ID=YOUR_PRODUCTION_GOOGLE_CLIENT_ID.apps.googleusercontent.com
