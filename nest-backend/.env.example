# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"

DATABASE_URL="postgresql://user:password@localhost:5432/freebay?schema=public"
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# Redis
REDIS_URL="redis://localhost:6379"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Freebay <no-reply@freebay.com>"
APP_URL=http://localhost:3333

# Twilio (SMS phone verification). When blank, the code is never sent and
# (outside production) is logged to the server console for local testing only.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

DEEP_LINK_SCHEME="freebay"
DEEP_LINK_HOST=""
CONNECT_ACCOUNT_COUNTRY="BR"
CONNECT_ACCOUNT_CURRENCY="brl"

# Platform commission on each sale, in percent. Defaults to 10 when unset.
PLATFORM_FEE_PERCENT=10

# Backend error reporting. Leave blank to disable Sentry entirely.
SENTRY_DSN=""
SENTRY_RELEASE=""

# Set to "true" outside production to log redacted request/response bodies.
LOG_DEBUG="false"

# Required. Google sign-in refuses to boot without at least one of these:
# with no audience bound, any Google-signed ID token would be accepted.
# Comma-separate to accept several OAuth clients (web + Android + iOS).
GOOGLE_CLIENT_ID=""
GOOGLE_SERVER_CLIENT_ID=""

# Lifetime of the biometric re-login credential.
JWT_BIOMETRIC_EXPIRES_IN="7d"
