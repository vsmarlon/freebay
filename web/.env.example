# FreeBay web — copy to .env.local and fill in. Never commit real values.

# Server-only (SSR + production server.mjs). Where the NestJS backend lives.
BACKEND_URL=http://localhost:3000

# Browser-exposed OAuth providers. A provider stays "not configured" until its keys exist.
# Google: create an OAuth client ID of type "Web application" in Google Cloud Console,
# authorized JavaScript origins: http://localhost:5173 (dev) + your production origin.
VITE_GOOGLE_WEB_CLIENT_ID=

# Apple Sign in (optional; requires an Apple developer account + verified domain).
VITE_APPLE_WEB_CLIENT_ID=
VITE_APPLE_WEB_REDIRECT_URI=
